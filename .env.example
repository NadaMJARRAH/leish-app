# Production URL of the "Leish Web Intake" webhook in n8n (POST)
N8N_INTAKE_URL=https://YOUR-NAME.app.n8n.cloud/webhook/leish-intake
# Production URL of the "LS API · Cases" webhook in n8n (GET)
N8N_CASES_URL=https://YOUR-NAME.app.n8n.cloud/webhook/leish-cases
# Shared secret. n8n checks it with Header Auth (header name: X-Leish-Key)
LEISH_API_KEY=change-me
